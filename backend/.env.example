# reqmesh backend configuration — copy to .env and uncomment what you need.
#
# Every setting is read with the RT_ prefix ("reqmesh"). The backend loads this
# file via pydantic-settings (env_file=".env"); values are the code defaults in
# app/core/config.py unless stated. The complete reference is in DEPLOYMENT.md.

# ── Profile & listen ─────────────────────────────────────────────────────────
# RT_PROFILE=personal          # personal | team | hardened (default team)
# RT_HOST=0.0.0.0
# RT_PORT=8000

# ── Data locations ───────────────────────────────────────────────────────────
# RT_DATA_ROOT=~/.reqmesh/projects   # project YAML lives here
# RT_STATE_DIR=~/.reqmesh            # accounts, secret, settings (keep OUTSIDE data root)
# RT_STATIC_DIR=../frontend/dist     # serve the built SPA (single-origin)

# ── Secrets & bootstrap ──────────────────────────────────────────────────────
# RT_SECRET=                   # JWT signing key; generated & persisted if unset
# RT_ADMIN_PASSWORD=           # initial admin password; generated if unset

# ── Auth & accounts ──────────────────────────────────────────────────────────
# RT_REQUIRE_AUTH=true         # false lets anonymous users read (personal profile)
# RT_ALLOW_SELF_REGISTRATION=false
# RT_REQUIRE_EMAIL_VERIFICATION=false
# RT_COOKIE_SECURE=true        # false for plain HTTP (localhost)
# RT_TOKEN_TTL_SECONDS=604800  # session length, seconds (7 days)
# RT_LOCKOUT_MAX_ATTEMPTS=5
# RT_LOCKOUT_WINDOW_MINUTES=15

# ── Host / origin guardrails ─────────────────────────────────────────────────
# RT_ALLOWED_HOSTS=*            # comma-separated; reject mismatched Host headers
# RT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── URLs & branding ──────────────────────────────────────────────────────────
# RT_BASE_URL=http://localhost:8000     # used for email links
# RT_INSTANCE_NAME=reqmesh
# RT_SUPPORT_EMAIL=

# ── Email (SMTP; empty host disables email) ─────────────────────────────────
# RT_SMTP_HOST=
# RT_SMTP_PORT=587
# RT_SMTP_USERNAME=
# RT_SMTP_PASSWORD=
# RT_SMTP_FROM=reqmesh@localhost
# RT_SMTP_USE_TLS=true

# ── Git integration ──────────────────────────────────────────────────────────
# RT_GIT_AUTOCOMMIT=true
# RT_GIT_REMOTE_URL=
# RT_GIT_PUSH_ON_COMMIT=false
# RT_GIT_PUSH_INTERVAL_MINUTES=0

# ── Misc ─────────────────────────────────────────────────────────────────────
# RT_SEED_DEMO=true             # create the Cessna example on first launch
# RT_OFFLINE_MODE=false         # suppress outbound git push / SMTP / update checks
# RT_LOG_LEVEL=INFO
# RT_DEBUG=false                # show stack traces in error responses
# RT_RATE_LIMIT_ENABLED=true    # set false only for the end-to-end suite
