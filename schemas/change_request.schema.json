{
  "$defs": {
    "CRStatus": {
      "enum": [
        "submitted",
        "in_review",
        "approved",
        "rejected",
        "implemented",
        "closed"
      ],
      "title": "CRStatus",
      "type": "string"
    },
    "CRUrgency": {
      "description": "How soon the change needs deciding.\n\nAn enum rather than a per-project list, unlike the risk vocabularies: a\nchange request's urgency is not an axis a project configures, and CRStatus\nabove is already an enum, so this stays consistent with its own file.",
      "enum": [
        "low",
        "normal",
        "high",
        "emergency"
      ],
      "title": "CRUrgency",
      "type": "string"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "default": "",
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "affected_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Affected Requirements",
      "type": "array"
    },
    "affected_components": {
      "items": {
        "type": "string"
      },
      "title": "Affected Components",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/CRStatus",
      "default": "submitted"
    },
    "urgency": {
      "$ref": "#/$defs/CRUrgency",
      "default": "normal"
    },
    "rationale": {
      "default": "",
      "title": "Rationale",
      "type": "string"
    },
    "changes": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Changes",
      "type": "object"
    },
    "creates": {
      "items": {
        "type": "string"
      },
      "title": "Creates",
      "type": "array"
    },
    "base_fingerprints": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Base Fingerprints",
      "type": "object"
    },
    "submitted_by": {
      "default": "",
      "title": "Submitted By",
      "type": "string"
    },
    "reviewed_by": {
      "default": "",
      "title": "Reviewed By",
      "type": "string"
    },
    "approved_by": {
      "default": "",
      "title": "Approved By",
      "type": "string"
    },
    "created": {
      "title": "Created",
      "type": "string"
    },
    "modified": {
      "title": "Modified",
      "type": "string"
    }
  },
  "required": [
    "id"
  ],
  "title": "reqmesh change_request",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
