### reqmesh nginx reverse proxy — generated by install wizard
### Re-run ./install.sh to reconfigure.

# Edge rate limiting; the auth zone is deliberately strict. The app also
# rate-limits per-IP and per-account.
limit_req_zone $binary_remote_addr zone=reqmesh_api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=reqmesh_auth:10m rate=1r/s;

upstream reqmesh_backend {
    server %_NGINX_UPSTREAM_%;
}

%_NGINX_HTTP_REDIRECT_%

server {
%_NGINX_LISTEN_%

    server_name ${DOMAIN};
%_NGINX_TLS_%

    # Security headers
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "0" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location / {
        limit_req zone=reqmesh_api burst=60 nodelay;
        proxy_pass http://reqmesh_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }

    # The credential endpoints get a much stricter edge limit, on top of the
    # app's own. Only these: the rest of /api/auth/ (whoami on every page load,
    # the admin user-management routes and their bulk actions) is ordinary
    # traffic and at 1r/s the Users page would be shed by its own requests.
    location ~ ^/api/auth/(login|register|guest|forgot-password|reset-password|verify-email|resend-verification)$ {
        limit_req zone=reqmesh_auth burst=5 nodelay;
        proxy_pass http://reqmesh_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }

    location /health {
        proxy_pass http://reqmesh_backend;
        access_log off;
    }

    client_max_body_size 50M;
}
