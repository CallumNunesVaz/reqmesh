### reqmesh systemd unit — generated by install wizard
### Re-run ./install.sh to reconfigure.

[Unit]
Description=reqmesh — requirements management server
Documentation=https://github.com/CallumNunesVaz/reqmesh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${REQMESH_USER}
Group=${REQMESH_GROUP}
WorkingDirectory=${INSTALL_DIR}
EnvironmentFile=${INSTALL_DIR}/.env
ExecStart=${INSTALL_DIR}/backend/.venv/bin/uvicorn app.main:app \
    --host ${HOST} \
    --port ${PORT} \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips "${PROXY_TRUSTED_CIDR}"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reqmesh
PrivateTmp=yes
NoNewPrivileges=yes
LimitNOFILE=65536

# Hardening (compatible with Python + weasyprint)
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=${DATA_ROOT} ${INSTALL_DIR}/backend/.venv
ReadOnlyPaths=${INSTALL_DIR}/backend/app
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
MemoryDenyWriteExecute=no
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
