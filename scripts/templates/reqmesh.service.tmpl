### reqmesh systemd unit — generated by install wizard
### Re-run ./install.sh to reconfigure.

[Unit]
Description=reqmesh — requirements management server
Documentation=https://github.com/CallumNunesVaz/reqmesh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${REQMESH_USER}
Group=${REQMESH_GROUP}
# uvicorn resolves `app.main:app` relative to the working directory, and
# app/ is installed under backend/ — pointing this at INSTALL_DIR gave
# "ModuleNotFoundError: No module named 'app'" on every start.
WorkingDirectory=${INSTALL_DIR}/backend
EnvironmentFile=${INSTALL_DIR}/.env
ExecStart=${INSTALL_DIR}/backend/.venv/bin/uvicorn app.main:app \
    --host ${HOST} \
    --port ${PORT} \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips "${PROXY_TRUSTED_CIDR}"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reqmesh
PrivateTmp=yes
NoNewPrivileges=yes
LimitNOFILE=65536

# Hardening (compatible with Python + weasyprint)
ProtectSystem=strict
ProtectHome=yes
# STATE_DIR holds users.yaml and the signing secret. Without it here,
# ProtectSystem=strict makes the account database read-only and login
# fails with PermissionError — exactly what the container's tmpfs did.
ReadWritePaths=${DATA_ROOT} ${STATE_DIR} ${INSTALL_DIR}/backend/.venv
ReadOnlyPaths=${INSTALL_DIR}/backend/app
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
MemoryDenyWriteExecute=no
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
